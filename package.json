{
  "name": "diogenes",
  "version": "1.0.0",
  "description": "Visual system-design canvas for coding agents",
  "main": "./out/main/index.js",
  "author": "Diogenes team",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "test": "vitest run",
    "smoke:db": "vitest run test/persistence"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@scip-code/scip": "0.10.0",
    "@sourcegraph/scip-typescript": "0.6.2",
    "@xyflow/react": "^13.0.2",
    "pg": "8.16.3",
    "simple-icons": "^16.38.0",
    "tar": "7.5.23"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.11.2"
}

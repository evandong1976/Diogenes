{
  "name": "Diogenes",
  "version": "0.1.0",
  "color": {
    "bg":            { "value": "#0B0D09", "note": "Forest black. App background, canvas ground." },
    "surface-1":     { "value": "#12150F", "note": "Panels, toolbars, status bar." },
    "surface-2":     { "value": "#181C13", "note": "Canvas nodes, toasts." },
    "surface-3":     { "value": "#20261A", "note": "Raised controls, active list row." },
    "border":        { "value": "#272D1F", "note": "Hairline dividers." },
    "border-strong": { "value": "#3A4230", "note": "Control outlines, node outlines." },
    "text":          { "value": "#ECE8DC", "note": "Primary text (cream)." },
    "text-2":        { "value": "#A9AB98", "note": "Secondary text." },
    "text-3":        { "value": "#80836F", "note": "Labels, metadata. Min 11px." },
    "accent":        { "value": "#F2962B", "note": "Marigold. Primary action, selection, proposed changes." },
    "on-accent":     { "value": "#0B0D09" },
    "warn":          { "value": "#F2C94C", "note": "Label yellow. Draft / warning." },
    "danger":        { "value": "#E0662A", "note": "Poppy. Errors, destructive." },
    "ok":            { "value": "#8FA33A", "note": "Moss. Healthy, success." },
    "info":          { "value": "#93A6AB", "note": "Steel. Info, links, datastores." },
    "selected":      { "value": "#3E4A1E", "note": "Olive. Selected tool / segment fill." },
    "connector":     { "value": "#59614B", "note": "Edges on the canvas." },
    "grid":          { "value": "#181C13", "note": "Canvas grid lines, 24px." }
  },
  "font": {
    "ui":  { "value": "'Manrope', sans-serif", "use": "Names, body copy, buttons, inputs." },
    "bit": { "value": "'OffBit', 'Pixelify Sans', monospace", "use": "Labels, IDs, paths, numbers, shortcuts, logs. Uppercase labels at +0.06em tracking." }
  },
  "type": {
    "display": { "font": "ui",  "size": 28, "weight": 700, "lineHeight": 1.1, "tracking": "-0.02em" },
    "title":   { "font": "ui",  "size": 16, "weight": 700, "lineHeight": 1.2 },
    "node":    { "font": "ui",  "size": 13, "weight": 600, "lineHeight": 1.2 },
    "body":    { "font": "ui",  "size": 12, "weight": 500, "lineHeight": 1.45 },
    "label":   { "font": "bit", "size": 11, "weight": 400, "lineHeight": 1, "tracking": "0.06em", "case": "upper" },
    "label-sm":{ "font": "bit", "size": 10, "weight": 400, "lineHeight": 1, "tracking": "0.06em", "case": "upper" },
    "data":    { "font": "bit", "size": 11, "weight": 400, "lineHeight": 1.2 }
  },
  "space": { "0": 0, "1": 2, "2": 4, "3": 6, "4": 8, "5": 12, "6": 16, "7": 24 },
  "radius": { "pane": 0, "control": 2 },
  "size": { "control": 26, "row": 24, "row-lg": 28, "titlebar": 34, "statusbar": 22, "grid": 24, "port": 6 },
  "border": { "hairline": "1px solid var(--dg-border)", "control": "1px solid var(--dg-border-strong)" },
  "shadow": "none"
}

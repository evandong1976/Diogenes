    "canvas": {
      "background": "bg",
      "dot": "dot",
      "dotSpacing": 16
    },
    "node": {
      "background": "surface-2",
      "border": "1px solid border-strong",
      "radius": 4,
      "shadow": "none",
      "widthMin": 160,
      "widthDefault": 260
    },
    "header": {
      "height": 40,
      "icon": 15,
      "title": "node",
      "metric": "label-sm · ok (running: ok, error: danger, proposed: accent)",
      "runButton": 22

    "description": {
      "maxHeight": 36,
      "font": "ui 11/500",
      "color": "text-2"
    },
    "field": {
      "height": 58,
      "labelFont": "ui 11/600",
      "requiredMark": "danger",
      "inputHeight": 28,
      "inputRadius": 2,
      "kinds": [
        "text",
        "secret",
        "select",
        "toggle",
        "locked",
        "expand"
      ]
    },
    "footer": {
      "height": 36,
      "background": "surface-1",
      "content": "output type ▾ + inspect icon, one output port"
    },
    "compactNode": {
      "height": 40,
      "ports": "one in (left) and/or one out (right), centered"
    },
    "port": {
      "size": 10,
      "ring": "2px bg",
      "types": {
        "http": "accent",
        "data": "info",
        "auth": "warn",
        "event": "ok"
      },
      "proposed": "hollow: bg fill, 2px type-colored border"
    },
    "edge": {
      "curve": "cubic, horizontal tangents",
      "width": 1.5,
      "widthActive": 2.5,
      "opacity": 0.85,
      "color": "source port type",
      "proposedDash": [
        5,
        4
      ]
    },
    "states": {
      "default": {
        "border": "border-strong"
      },
      "selected": {
        "border": "accent",
        "ring": "0 0 0 3px rgba(242,150,43,.18)"
      },
      "running": {
        "topBar": "2px ok",
        "metric": "ok"
      },
      "error": {
        "border": "danger",
        "footerRow": "rgba(224,102,42,.08) bg, message in bit 10 danger"
      },
      "proposed": {
        "border": "1px dashed accent",
        "background": "rgba(242,150,43,.04)",
        "ports": "hollow"
      }
    },
    "promptPin": {
      "background": "surface-1",
      "border": "1px solid accent",
      "radius": 4,
      "header": "bit label 'PROMPT #n · @NODE' in accent",
      "action": "primary button 'Send to Claude Code ⌘↵'",
      "port": "http, left"
    }
  }
}

        "icon": "<rect x=\"3\" y=\"3\" width=\"7\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"15\" width=\"7\" height=\"6\" rx=\"1\"/><path d=\"M6.5 9v5a2 2 0 0 0 2 2H14\"/>"
      },
      "generic": {
        "label": "NODE",
        "form": "compact",
        "shows": [

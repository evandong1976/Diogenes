{
  "name": "Diogenes",
  "version": "0.3.0",
  "color": {
    "bg": {
      "value": "#0B0D09",
      "note": "Forest black. App background, canvas ground."
    },
    "surface-1": {
      "value": "#12150F",
      "note": "Panels, toolbars, status bar."
    },
    "surface-2": {
      "value": "#181C13",
      "note": "Canvas nodes, toasts."
    },
    "surface-3": {
      "value": "#20261A",
      "note": "Raised controls, active list row."
    },
    "border": {
      "value": "#272D1F",
      "note": "Hairline dividers."
    },
    "border-strong": {
      "value": "#3A4230",
      "note": "Control outlines, node outlines."
    },
    "text": {
      "value": "#ECE8DC",
      "note": "Primary text (cream)."
    },
    "text-2": {
      "value": "#A9AB98",
      "note": "Secondary text."
    },
    "text-3": {
      "value": "#80836F",
      "note": "Labels, metadata. Min 11px."
    },
    "accent": {
      "value": "#F2962B",
      "note": "Marigold. Primary action, selection, proposed changes."
    },
    "on-accent": {
      "value": "#0B0D09"
    },
    "warn": {
      "value": "#F2C94C",
      "note": "Label yellow. Draft / warning."
    },
    "danger": {
      "value": "#E0662A",
      "note": "Poppy. Errors, destructive."
    },
    "ok": {
      "value": "#8FA33A",
      "note": "Moss. Healthy, success."
    },
    "info": {
      "value": "#93A6AB",
      "note": "Steel. Info, links, datastores."
    },
    "selected": {
      "value": "#3E4A1E",
      "note": "Olive. Selected tool / segment fill."
    },
    "connector": {
      "value": "#59614B",
      "note": "Edges on the canvas."
    },
    "grid": {
      "value": "#181C13",
      "note": "Canvas grid lines, 24px."
    },
    "dot": {
      "value": "#2E3424",
      "note": "Canvas dot grid, 1px dots every 16px."
    },
    "port-request": {
      "value": "#F2962B",
      "note": "= accent. http, rpc, electron-ipc, cli."
    },
    "port-data": {
      "value": "#93A6AB",
      "note": "= info. data, state."
    },
    "port-event": {
      "value": "#8FA33A",
      "note": "= ok. event, schedule."
    },
    "port-nav": {
      "value": "#F2C94C",
      "note": "= warn. navigation (takes over auth's yellow)."
    },
    "port-local": {
      "value": "#A9AB98",
      "note": "= text-2. local (in-process import / call)."
    },
    "unresolved": {
      "value": "#80836F",
      "note": "= text-3. Dotted border of unresolved nodes and edges."
    },
    "unresolved-tint": {
      "value": "rgba(147,166,171,.08)",
      "note": "Steel tint behind the unresolved reason row. Deliberately not poppy."
    },
    "reject-tint": {
      "value": "rgba(224,102,42,.10)",
      "note": "Poppy tint behind rejection messages."
    }
  },
  "font": {
    "ui": {
      "value": "'Manrope', sans-serif",
      "use": "Names, body copy, buttons, inputs."
    },
    "bit": {
      "value": "'OffBit', 'Pixelify Sans', monospace",
      "use": "Labels, IDs, paths, numbers, shortcuts, logs. Uppercase labels at +0.06em tracking."
    }
  },
  "type": {
    "display": {
      "font": "ui",
      "size": 28,
      "weight": 700,
      "lineHeight": 1.1,
      "tracking": "-0.02em"
    },
    "title": {
      "font": "ui",
      "size": 16,
      "weight": 700,
      "lineHeight": 1.2
    },
    "node": {
      "font": "ui",
      "size": 13,
      "weight": 600,
      "lineHeight": 1.2
    },
    "body": {
      "font": "ui",
      "size": 12,
      "weight": 500,
      "lineHeight": 1.45
    },
    "label": {
      "font": "bit",
      "size": 11,
      "weight": 400,
      "lineHeight": 1,
      "tracking": "0.06em",
      "case": "upper"
    },
    "label-sm": {
      "font": "bit",
      "size": 10,
      "weight": 400,
      "lineHeight": 1,
      "tracking": "0.06em",
      "case": "upper"
    },
    "data": {
      "font": "bit",
      "size": 11,
      "weight": 400,
      "lineHeight": 1.2
    }
  },
  "space": {
    "0": 0,
    "1": 2,
    "2": 4,
    "3": 6,
    "4": 8,
    "5": 12,
    "6": 16,
    "7": 24
  },
  "radius": {
    "pane": 0,
    "control": 2
  },
  "size": {
    "control": 26,
    "row": 24,
    "row-lg": 28,
    "titlebar": 34,
    "statusbar": 22,
    "grid": 24,
    "port": 6
  },
  "border": {
    "hairline": "1px solid var(--dg-border)",
    "control": "1px solid var(--dg-border-strong)"
  },
  "shadow": "none",
  "graph": {
    "canvas": {
      "background": "bg",
      "dot": "dot",
      "dotSpacing": 16
    },
    "node": {
      "background": "surface-2",
      "border": "1px solid border-strong",
      "radius": 4,
      "shadow": "none",
      "widthMin": 160,
      "widthDefault": 260
    },
    "header": {
      "height": 40,
      "icon": 15,
      "title": "node",
      "metric": "label-sm · ok (running: ok, error: danger, proposed: accent)",
      "runButton": 22
    },
    "description": {
      "maxHeight": 36,
      "font": "ui 11/500",
      "color": "text-2"
    },
    "field": {
      "height": 58,
      "labelFont": "ui 11/600",
      "requiredMark": "danger",
      "inputHeight": 28,
      "inputRadius": 2,
      "kinds": [
        "text",
        "secret",
        "select",
        "toggle",
        "locked",
        "expand"
      ]
    },
    "footer": {
      "height": 36,
      "background": "surface-1",
      "content": "output type ▾ + inspect icon, one output port"
    },
    "compactNode": {
      "height": 40,
      "ports": "one in (left) and/or one out (right), centered"
    },
    "port": {
      "size": 10,
      "ring": "2px bg",
      "types": {
        "http": "accent",
        "data": "info",
        "auth": "deprecated alias of port-nav color; no catalog protocol uses it. Remove in v0.4.",
        "event": "ok"
      },
      "proposed": "hollow: bg fill, 2px type-colored border"
    },
    "edge": {
      "curve": "cubic, horizontal tangents",
      "width": 1.5,
      "widthActive": 2.5,
      "opacity": 0.85,
      "color": "source port type",
      "proposedDash": [
        5,
        4
      ]
    },
    "states": {
      "default": {
        "border": "border-strong"
      },
      "selected": {
        "border": "accent",
        "ring": "0 0 0 3px rgba(242,150,43,.18)"
      },
      "running": {
        "topBar": "2px ok",
        "metric": "ok"
      },
      "error": {
        "border": "danger",
        "footerRow": "rgba(224,102,42,.08) bg, message in bit 10 danger"
      },
      "proposed": {
        "border": "1px dashed accent",
        "background": "rgba(242,150,43,.04)",
        "ports": "hollow"
      }
    },
    "promptPin": {
      "background": "surface-1",
      "border": "1px solid accent",
      "radius": 4,
      "header": "bit label 'PROMPT #n · @NODE' in accent",
      "action": "primary button 'Send to Claude Code ⌘↵'",
      "port": "http, left"
    }
  },

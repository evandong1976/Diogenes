    "iconViewBox": "0 0 24 24 · stroke 1.8, round caps/joins, no fill",
    "typeLabel": "OffBit 10, uppercase, +0.06em, text-3, max 8 chars. workload shows its role, resource shows its type.",
    "compactNode": "40px, two lines: name (Manrope 12/600) over the key attribute (OffBit 10, text-2); TYPE label right. A 22px reason strip appears under it only when unresolved or error.",
    "resolution": {
      "bound": {
        "border": "1px solid border-strong",
        "background": "surface-2",
        "icon": "text",
        "ports": "filled",
        "edge": "solid"
      },
      "declared": {
        "border": "1px solid border",
        "background": "surface-1",
        "icon": "text-2",
        "title": "text-2",
        "ports": "filled",
        "edge": "solid, 45% opacity",
        "footerTag": "DECLARED · config file"
      },
      "unresolved": {
        "border": "1px dotted unresolved",
        "background": "surface-1 + 45° hatch 1px/6px at 3%",
        "icon": "text-3",
        "ports": "40% mix of port color into bg",
        "edge": "dash 2 4 + ? chip",
        "reasonRow": "unresolved-tint bg, info text, '?' glyph + reason"
      },
      "proposed": {
        "border": "1px dashed accent",
        "background": "rgba(242,150,43,.04)",
        "ports": "hollow",
        "edge": "dash 5 4"
      }
    },
    "combining": "Resolution owns border STYLE, fill, icon tone and port fill. Interaction state owns border COLOR, ring and top bar. Color priority: error > selected > running > resolution. So selected+unresolved = dotted marigold + ring; proposed+error = dashed poppy + error row, hollow ports.",
    "protocols": {
      "local": {
        "code": "LOCAL",
        "family": "local",
        "color": "port-local",
        "shape": "circle"
      },
      "electron-ipc": {
        "code": "IPC",
        "family": "request",
        "color": "port-request",
        "shape": "circle"
      },
      "http": {
        "code": "HTTP",
        "family": "request",
        "color": "port-request",
        "shape": "circle"
      },
      "rpc": {
        "code": "RPC",
        "family": "request",
        "color": "port-request",
        "shape": "circle"
      },
      "cli": {
        "code": "CLI",
        "family": "request",
        "color": "port-request",
        "shape": "circle"
      },
      "event": {
        "code": "EVT",
        "family": "event",
        "color": "port-event",
        "shape": "diamond"
      },
      "schedule": {
        "code": "SCHED",
        "family": "event",
        "color": "port-event",
        "shape": "diamond"
      },
      "data": {
        "code": "DATA",
        "family": "data",
        "color": "port-data",
        "shape": "square"
      },
      "state": {
        "code": "STATE",
        "family": "data",
        "color": "port-data",
        "shape": "square"
      },
      "navigation": {
        "code": "NAV",
        "family": "navigation",
        "color": "port-nav",
        "shape": "triangle"
      }
    },
    "portShapes": {
      "circle": "request + local",
      "square": "data family (r1)",
      "diamond": "event family (45° square)",
      "triangle": "navigation (points right)"
    },
    "protocolCodeShownIn": [
      "footer output (e.g. IPC ▾)",
      "edge chip on hover",
      "port aria-label + tooltip"
    ],
    "connections": {
      "contains": {
        "draw": "group",
        "note": "No line. Parent becomes a frame around its children; collapsed parents show a ▸ N badge."
      },
      "depends_on": {
        "draw": "line",
        "stroke": "text-3",
        "width": 1,
        "dash": [
          1,
          3
        ],
        "chip": null,
        "note": "Structural; grey dotted, never colored by port."
      },
      "calls": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": null,
        "note": "The default edge. No chip."
      },
      "publishes_to": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": "PUB"
      },
      "subscribes_to": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": "SUB"
      },
      "reads": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": "R",
        "note": "reads + writes between the same pair merge into one edge with chip R/W."
      },
      "writes": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": "W"
      },
      "triggers": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": "TRIG"
      },
      "flows_to": {
        "draw": "line",
        "stroke": "source-port",
        "width": 2,
        "chip": null,
        "arrow": true,
        "note": "Workflow sequence; heavier line with arrowhead."
      },
      "navigates_to": {
        "draw": "line",
        "stroke": "source-port",
        "width": 1.5,
        "chip": null,
        "arrow": true
      }
    },
    "edgeChip": "OffBit 9, uppercase, 1px border in edge color, bg fill, centered on the curve midpoint.",
    "group": {
      "border": "1px solid border",
      "background": "rgba(236,232,220,.02)",
      "radius": 4,
      "label": "OffBit 10 tab at top-left: TYPE · name",
      "paddingTop": 28
    },
    "evidence": {
      "format": "path:start–end (en dash)",
      "truncate": "middle; always keep the filename and range",
      "overflow": "+N pill; inspector header reads 'N SOURCES'",
      "where": "left side of the node footer; edges show it on hover and in the inspector",
      "sourceKinds": {
        "code": "traced through code → bound",
        "config": "from config → declared"
      }
    },
    "rejection": {
      "codes": {
        "stale": {
          "label": "STALE",
          "message": "The repo changed since this canvas was scanned. Re-scan, then try again."
        },
        "duplicate": {
          "label": "DUPLICATE",
          "message": "That already exists on the canvas."
        },
        "missing": {
          "label": "MISSING",
          "message": "The node or port this edit refers to no longer exists."
        },
        "dangling": {
          "label": "DANGLING",
          "message": "This connection has no node on one end."
        },
        "invalid-node": {
          "label": "INVALID-NODE",
          "message": "This node is missing a required field."
        },
        "invalid-edge": {
          "label": "INVALID-EDGE",
          "message": "That connection kind isn't allowed between these two nodes."
        },
        "invalid-port": {
          "label": "INVALID-PORT",
          "message": "That port doesn't exist on this node."
        },
        "incompatible": {
          "label": "INCOMPATIBLE",
          "message": "These ports speak different protocols."
        },
        "unsupported": {
          "label": "UNSUPPORTED",
          "message": "This change can't be made from the canvas yet."
        }
      },
      "inline": "Callout attached 6px below the node (or at the edge midpoint), poppy 1px border, reject-tint bg, OffBit 'REJECTED · CODE' + one-line message + Undo.",
      "global": "Banner at the top of the canvas when the edit isn't tied to one node (stale, unsupported): same styling, full width, with the fix action (Re-scan)."
    }
  }
}
